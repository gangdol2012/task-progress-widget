<?xml version="1.0" encoding="utf-8"?>
<!-- The .pkg installer's layout; make-release-mac.sh fills in __VERSION__. -->
<installer-gui-script minSpecVersion="2">
    <title>Claude Progress</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.ohmygoditisme.claude-progress.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.ohmygoditisme.claude-progress.pkg" visible="false">
        <pkg-ref id="io.github.ohmygoditisme.claude-progress.pkg"/>
    </choice>
    <pkg-ref id="io.github.ohmygoditisme.claude-progress.pkg" version="__VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
